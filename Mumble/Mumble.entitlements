<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required under the hardened runtime (needed for notarization); without it the
	     microphone silently delivers no audio. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Hardened runtime resource access for meeting notes: calendar attendees and titles. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
